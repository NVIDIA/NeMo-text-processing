# The sdist has to be able to build itself and prove it worked: the linker
# scripts are referenced by setup.py, build_openfst.sh is what cibuildwheel
# runs before anything else, and the toy grammars are what the wheel test
# command exercises.
include src/lightning.map
include src/lightning.exported_symbols
include build.sh
recursive-include scripts *.sh
recursive-include tests *.py
recursive-include tests/data *.far
